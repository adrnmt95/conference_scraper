# Choose brave, tavily, or auto (all providers with configured keys).
SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Both are required to enable semantic extraction and evaluation.
# Select a Responses API model supporting Structured Outputs in your account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Project-local state; reuse the same directory to retain conference memory.
CONFERENCE_STATE_DIR=.conference-agent
REQUEST_INTERVAL_SECONDS=1.2
HTTP_TIMEOUT_SECONDS=25
SEARCH_CACHE_HOURS=12
SOURCE_CACHE_HOURS=1
# Domains whose terms prohibit automated access, comma separated.
BLOCKED_DOMAINS=
# Extra organiser domains you have checked, comma separated. Trust is explicit.
OFFICIAL_DOMAINS=
# Optional contact, added to the crawler's identifiable user agent.
CRAWLER_CONTACT=
